<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <!-- TITLE -->
    <TextView
        android:id="@+id/titleProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/onelittlefont_regular"
        android:text="Profile"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- PROFILE IMAGE -->
    <FrameLayout
        android:id="@+id/profileImageContainer"
        android:layout_width="126dp"
        android:layout_height="126dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/edittext_border"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleProfile">

        <ImageView
            android:id="@+id/setupprofile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:scaleType="centerInside"
            android:src="@drawable/profile_icon" />

        <ImageButton
            android:id="@+id/btnChangeImage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/profile_bg"
            android:padding="4dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/usernameBox"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toEndOf="@id/profileImageContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/profileImageContainer">

        <TextView
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/onelittlefont_regular"
            android:background="@drawable/edittext_border"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="FIRST NAME"
            android:textColor="#6A5B3A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- LAST NAME -->
    <FrameLayout
        android:id="@+id/cityBox"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="21dp"
        android:background="@drawable/edittext_border"
        app:layout_constraintStart_toStartOf="@id/usernameBox"
        app:layout_constraintEnd_toEndOf="@id/usernameBox"
        app:layout_constraintTop_toBottomOf="@id/usernameBox">

        <TextView
            android:id="@+id/city"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/onelittlefont_regular"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="LAST NAME"
            android:textColor="#6A5B3A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/titleAchievements"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/onelittlefont_regular"
        android:background="@drawable/achievement_header"
        android:gravity="center"
        android:text="ACHIEVEMENTS"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileImageContainer" />

    <!-- ACHIEVEMENTS GRID -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="24dp"
        android:padding="0dp"
        app:layout_constraintTop_toBottomOf="@id/titleAchievements"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <GridLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3">

            <ImageView
                android:id="@+id/badge1"
                style="@style/badge1"/>

            <ImageView
                android:id="@+id/badge2"
                style="@style/badge2"/>

            <ImageView
                android:id="@+id/badge3"
                style="@style/badge3"/>

            <ImageView
                android:id="@+id/badge4"
                style="@style/badge4"/>

            <ImageView
                android:id="@+id/badge5"
                style="@style/badge5"/>

            <ImageView
                android:id="@+id/badge6"
                style="@style/badge6"/>

            <ImageView
                android:id="@+id/badge7"
                style="@style/badge7"/>

            <ImageView
                android:id="@+id/badge8"
                style="@style/badge8"/>

            <ImageView
                android:id="@+id/badge9"
                style="@style/badge9"/>

            <ImageView
                android:id="@+id/badge10"
                style="@style/badge10"/>

            <ImageView
                android:id="@+id/badge11"
                style="@style/badge11"/>

            <ImageView
                android:id="@+id/badge12"
                style="@style/badge12"/>

            <ImageView
                android:id="@+id/badge13"
                style="@style/badge13"/>

            <ImageView
                android:id="@+id/badge14"
                style="@style/badge14"/>

            <ImageView
                android:id="@+id/badge15"
                style="@style/badge15"/>

            <ImageView
                android:id="@+id/badge16"
                style="@style/badge16"/>

            <ImageView
                android:id="@+id/badge17"
                style="@style/badge17"/>

            <ImageView
                android:id="@+id/badge18"
                style="@style/badge18"/>

            <ImageView
                android:id="@+id/badge19"
                style="@style/badge19"/>

            <ImageView
                android:id="@+id/badge20"
                style="@style/badge20"/>

            <ImageView
                android:id="@+id/badge21"
                style="@style/badge21"/>

            <ImageView
                android:id="@+id/badge22"
                style="@style/badge22"/>

            <ImageView
                android:id="@+id/badge23"
                style="@style/badge23"/>

            <ImageView
                android:id="@+id/badge24"
                style="@style/badge24"/>
        </GridLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/firefly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/firefly_icon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/plant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/plant_icon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/location_icon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/profile_icon" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>